# ═══════════════════════════════════════════════════════════════
#  PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ═══════════════════════════════════════════════════════════════
#  Copy this file as .env and fill in your actual values

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name
# or
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# JWT Security (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_key_here_generate_a_random_string

# Admin Credentials
ADMIN_EMAIL=admin@edutrack.edu
ADMIN_PASSWORD=admin123

# Email Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM_NAME="Acadexa by Asad"
MAIL_FROM_EMAIL=your_email@gmail.com
FEEDBACK_RECEIVER_EMAIL=your_email@gmail.com

# Frontend URL
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Environment
NODE_ENV=production

# Server Port
PORT=5001

# ═══════════════════════════════════════════════════════════════
#  ACADEXA AI (multi-provider — orchestrator falls back in priority
#  order across whichever of these are actually set; none are
#  required for the rest of the app to run)
# ═══════════════════════════════════════════════════════════════
# NOTE: these exact names (including case) are what the code reads —
# keep them as-is if copying real values in.
GEMINI_API_KEY=
Groq_API_KEY=
care_brass_API_KEY=
open_router_API_KEY=

# Optional — pin a single provider instead of auto priority+fallback
# (gemini | groq | cerebras | openrouter)
AI_PROVIDER=auto

# Optional — override default models per provider
GEMINI_MODEL=
GROQ_MODEL=
CEREBRAS_MODEL=
OPENROUTER_MODEL=

# ═══════════════════════════════════════════════════════════════
#  CHAT (Socket.IO real-time messaging)
# ═══════════════════════════════════════════════════════════════
# No new variables needed — chat reuses MONGO_URI, JWT_SECRET, and
# FRONTEND_URL/the allowedOrigins list above for its own CORS check.
#
# IMPORTANT: Socket.IO only attaches when this server runs as a real,
# always-on process (i.e. the branch of server.js that calls
# httpServer.listen() — local `npm run dev`/`npm start`, or this same
# server.js deployed to a non-Vercel host such as Render, Railway, Fly.io,
# or a VPS). It does NOT run on Vercel: serverless functions don't keep a
# persistent process alive to hold WebSocket connections open, so on a
# Vercel-only deployment the chat REST endpoints (send/receive/read,
# under /api/chat) still work normally, but messages won't push live —
# the frontend detects this and falls back to a clear "offline" indicator
# with REST-only sending rather than breaking.
#
# To get live chat in production, deploy backend/server.js to an always-on
# host and point the frontend's VITE_SOCKET_URL (see the root .env.example)
# at it — it can run alongside the existing Vercel-hosted REST API.
